@model IEnumerable<RaceDay.Web.Models.EnrolmentViewModel>
@{
    ViewData["Title"] = "My Enrolments";
}

<h2 class="mb-4">📋 My Event Enrolments</h2>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Event Name</th>
                <th>Category</th>
                <th>Enrolment Date</th>
                <th>Payment Status</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.EventName</td>
                    <td>@item.CategoryName</td>
                    <td>@item.EnrolmentDate.ToString("yyyy-MM-dd")</td>
                    <td><span class="badge bg-secondary">@item.PaymentStatus</span></td>
                    <td>
                        @if (item.Status == "Confirmed")
                        {
                            <span class="badge bg-success">Confirmed</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
