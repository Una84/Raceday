@model IEnumerable<RaceDay.Web.Models.EventViewModel>
@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>🏆 Upcoming Events</h2>
    @if (Context.Session.GetString("UserRole") == "Organiser")
    {
        <a asp-controller="Organiser" asp-action="CreateEvent" class="btn btn-warning fw-bold">+ Create New Event</a>
    }
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                @if (!string.IsNullOrEmpty(item.PosterUrl))
                {
                    <img src="@item.PosterUrl" class="card-img-top" alt="@item.EventName" style="height: 180px; object-fit: cover;" />
                }
                else
                {
                    <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 180px;">
                        <span>No Poster Image</span>
                    </div>
                }
                <div class="card-body">
                    <span class="badge bg-primary mb-2">@item.EventType</span>
                    <h5 class="card-title text-dark">@item.EventName</h5>
                    <p class="card-text text-muted small mb-2">📍 @item.Location | 📅 @item.EventDate.ToString("yyyy-MM-dd")</p>
                    <p class="card-text">@(item.EventDescription?.Length > 100 ? item.EventDescription.Substring(0, 100) + "..." : item.EventDescription)</p>
                </div>
                <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-success">@(item.RouteDistance.HasValue ? $"{item.RouteDistance} km" : "N/A")</span>
                    <a asp-action="Details" asp-route-id="@item.EventID" class="btn btn-outline-dark btn-sm">View Details</a>
                </div>
            </div>
        </div>
    }
</div>
